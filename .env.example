# Supabase (Phase 1: Supabase Cloud project. Phase 3: same variables point at
# a self-hosted Supabase stack on borneo.kg — nothing in the code changes.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Brand — single place to rename the marketplace away from the CarBridge
# placeholder once a final name is approved.
NEXT_PUBLIC_SITE_NAME=CarBridge
NEXT_PUBLIC_SITE_DESCRIPTION=Автомобили из Китая и в наличии в Бишкеке

# i18n
NEXT_PUBLIC_DEFAULT_LOCALE=ru
NEXT_PUBLIC_SUPPORTED_LOCALES=ru,en

# Currency — displayed alongside KGS on every price. The KGS/USD rate itself
# lives in the `app_settings` table (admin-editable), this is only a fallback
# used until that row is seeded.
NEXT_PUBLIC_DEFAULT_USD_KGS_RATE=89.5

# Lead notifications (optional on MVP — notify() no-ops silently if unset)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Base URL of the deployed site, used for absolute links in notifications.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
